# ========================================================
# DATABASE PERSISTENCE (Aiven.io MySQL or Local File)
# ========================================================
# 1. Aiven.io MySQL Service URI (Paste your Service URI from Aiven Console):
# DATABASE_URL="mysql://avnadmin:YOUR_AIVEN_PASSWORD@mysql-xxxx-yourproject.a.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED"

# 2. Or individual MySQL environment variables:
# MYSQL_HOST="mysql-xxxx-yourproject.a.aivencloud.com"
# MYSQL_PORT="12345"
# MYSQL_USER="avnadmin"
# MYSQL_PASSWORD="YOUR_AIVEN_PASSWORD"
# MYSQL_DATABASE="defaultdb"

# 3. Default zero-config local persistence mode:
DATABASE_URL="file:./dev.db"

# Authentication
AUTH_SECRET="shree_vidhi_super_secret_jwt_key_2026_at_least_32_chars_long"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin Seed
ADMIN_EMAIL="shreevidhiorganics@gmail.com"
ADMIN_PASSWORD="Admin@ShreeVidhi2026"

# PayU Live Merchant Gateway
# Get these from your PayU Merchant Dashboard -> Settings -> API Keys
PAYU_MERCHANT_KEY="your_payu_merchant_key"
PAYU_MERCHANT_SALT="your_payu_merchant_salt"
# Set to 'production' for live payments or 'test' for PayU Sandbox simulator
PAYU_ENV="production"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Razorpay Payment Gateway (Test Mode)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="placeholder_secret_key"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"

# Cloudinary (Optional for asset uploads)
CLOUDINARY_CLOUD_NAME="placeholder_cloud"
CLOUDINARY_API_KEY="placeholder_api_key"
CLOUDINARY_API_SECRET="placeholder_api_secret"

# Transactional Email (Optional)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="orders@shreevidhiorganics.com"

# ========================================================
# SHIPROCKET LOGISTICS & LIVE ORDER TRACKING
# ========================================================
# Get these from your Shiprocket account settings (API -> Credentials)
SHIPROCKET_EMAIL="your_shiprocket_email@example.com"
SHIPROCKET_PASSWORD="your_shiprocket_password"
# Pickup Location nickname created in your Shiprocket dashboard (default: "Primary")
SHIPROCKET_PICKUP_LOCATION="Primary"

# ========================================================
# FAST2SMS GATEWAY (INDIA OTP & ALERTS)
# ========================================================
# Get this from Fast2SMS Dashboard -> Dev API
FAST2SMS_API_KEY="your_fast2sms_api_key_here"

# ========================================================
# RESEND TRANSACTIONAL EMAIL
# ========================================================
# Get this from resend.com -> API Keys
RESEND_API_KEY="re_your_resend_api_key_here"
EMAIL_FROM="Shree Vidhi Organics <orders@shreevidhiorganics.com>"
